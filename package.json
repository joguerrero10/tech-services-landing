{
  "name": "tech-services-landing",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/generate-seo.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "format": "prettier --write src docs README.md design-qa.md scripts package.json tsconfig.json",
    "format:check": "prettier --check src docs README.md design-qa.md scripts package.json tsconfig.json",
    "check:styles": "node scripts/check-styles.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:i18n-validator": "node --test scripts/check-i18n.test.mjs",
    "build:production": "ng build && SEO_ENV=production node scripts/generate-seo.mjs",
    "check:prerender": "node scripts/check-prerender.mjs",
    "serve:static": "node scripts/serve-static.mjs",
    "test:seo": "node --test scripts/seo-files.test.mjs",
    "check:public": "node scripts/check-public.mjs",
    "build:pages": "ng build --base-href /tech-services-landing/ && SEO_ENV=production node scripts/generate-seo.mjs"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.2.0",
    "@ngx-translate/core": "^18.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "type": "module"
}
